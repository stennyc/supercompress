"""
Supercompress Context Engine v2 - Aligned with Reasonix architecture

Key changes from v1:
1. Compaction: Generate structured summary (like Reasonix's compaction-summary)
2. Auto-recall: BM25 semantic search instead of keyword matching
3. Recall format: Preamble + structured output (like Reasonix)
"""

from __future__ import annotations

import hashlib
import json
import logging
import math
import re
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from agent.context_engine import ContextEngine
from agent.model_metadata import estimate_messages_tokens_rough

# TCM-Net Integration
try:
    from integration import get_bridge, CompressionHint
    TCMNET_INTEGRATION = True
except ImportError:
    TCMNET_INTEGRATION = False

logger = logging.getLogger(__name__)
logger.setLevel(logging.WARNING)  # Only WARNING and above to reduce CLI noise

# Ensure logger has handlers (inherit from root if needed)
if not logger.handlers:
    # Propagate to root logger which has handlers configured by Hermes
    logger.propagate = True

# Load config at module level
try:
    from hermes_cli.config import cfg_get, load_config
    _config = load_config()
except ImportError:
    _config = {}


def _cfg_get(key: str, default=None):
    """Wrapper for cfg_get that handles dot-notation keys."""
    if not _config:
        return default
    keys = key.split('.')
    result = _config
    for k in keys:
        if isinstance(result, dict):
            result = result.get(k, default)
        else:
            return default
    return result if result is not None else default


# Default configuration
DEFAULT_MAX_TAIL_TURNS = 15
DEFAULT_MAX_TAIL_TOKENS = 32000
DEFAULT_EXTERNAL_STORE_PATH = "~/.hermes/supercompress_store/"
DEFAULT_COMPACT_RATIO = 0.50
DEFAULT_FORCE_COMPACT_RATIO = 0.75

# Reasonix-style constants
SUMMARY_TAG_OPEN = "<compaction-summary>"
SUMMARY_TAG_CLOSE = "</compaction-summary>"
AUTO_RECALL_PREAMBLE = "Automatically recalled context from previous turns. May be stale; verify before relying on."
MAX_RECALL_RESULTS = 4
MAX_RECALL_CHARS = 2400

# Dynamic recall thresholds
DEFAULT_RECALL_THRESHOLD = 50000  # Pre-compression threshold
DEFAULT_COMPRESSED_RECALL_THRESHOLD = 32000  # Post-compression threshold (2x max_tail_tokens)

# Max messages to process per compaction batch
MAX_COMPACT_BATCH = 50

# Required summary sections (must be present for task continuity)
REQUIRED_SUMMARY_SECTIONS = [
    "## Standing facts & constraints",
    "## Goal",
    "## Pending & next step",
]

# Optional but recommended sections
RECOMMENDED_SUMMARY_SECTIONS = [
    "## Decisions & rationale",
    "## Files & code",
    "## Commands & outcomes",
    "## Errors & fixes",
]

# Default placeholder for missing required sections
DEFAULT_SECTION_PLACEHOLDER = {
    "## Standing facts & constraints": "[No constraints recorded - verify current state]",
    "## Goal": "[No explicit goal - continue current task]",
    "## Pending & next step": "[No pending items - refer to recent messages]",
}

# LLM summary generation config
